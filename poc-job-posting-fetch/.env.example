# Copy to .env before running. None of these are real secrets - the
# Arbeitsagentur key is a documented public literal, not a per-account key -
# but they're env vars anyway instead of hardcoded, unlike poc-typst-cv's
# db_extractor.py (see feature_spec.md §2, Goals).

ARBEITSAGENTUR_API_KEY=jobboerse-jobsuche
HTTP_TIMEOUT_SECONDS=10
FETCH_USER_AGENT=Mozilla/5.0 (compatible; HustlenJobPostingPOC/1.0; +https://hustlen.ai)
LOG_LEVEL=INFO
PORT=8002
