# Issue #355 — referencia de qué variables necesita poc-pgvector-matching/.env
# en la EC2 de producción. En el flujo real (ver ec2-code-deploy-manual.md)
# ese .env NO se copia a mano: lo arma 04-fetch-secrets-and-start.sh leyendo
# estos mismos nombres desde SSM Parameter Store (SecureString). Este archivo
# queda solo como documentación de los campos — NUNCA usar los defaults de
# desarrollo en producción.

# Password de chamba_jobs_hot (container `db` de este mismo stack).
JOBS_DB_PASSWORD=

# Credenciales del rol de SOLO LECTURA contra la DB real. En staging es
# app_reader / cover_letter_db_stg (NO chambai/poc_pgvector_reader — esos
# son los defaults de dev-infra, hardcodeados como fallback en
# docker-compose.yml pero pensados para overridearse acá en producción).
BACKEND_DB_HOST=
BACKEND_DB_PORT=5432
BACKEND_DB_USER=app_reader
BACKEND_DB_PASSWORD=
BACKEND_DB_NAME=cover_letter_db_stg

# Credenciales del rol matching_service (esquema `matching`, misma DB de
# arriba) — creado por sql/001-create-matching-service-role.sql. Distinto
# del rol de solo lectura de arriba — este SÍ escribe, pero solo en ese
# esquema. MATCHING_DB_NAME debe ser la misma DB que BACKEND_DB_NAME.
MATCHING_DB_PASSWORD=
MATCHING_DB_NAME=cover_letter_db_stg
